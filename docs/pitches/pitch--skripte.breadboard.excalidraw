      "groupIds": [],
      "index": "ar",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "import holzwirtschaft\nevery 30s\n\nqry:genug-holz(n)\n    return stock.wood >= n * 8\nend\n\ncmd:reihe(n)\n    for i in 1..n\n        await place:hütte\n        right:3\n    end\nend\n\nif genug-holz(3) then\n    reihe:3\n    say \"Hütte: {building-at(cursor.x - 3, cursor.y).state}\"\nelse\n    wait until genug-holz(3)\nend",
      "roughness": 1,
      "roundness": null,
      "seed": 175593967,
      "strokeColor": "#868e96",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "import holzwirtschaft\nevery 30s\n\nqry:genug-holz(n)\n    return stock.wood >= n * 8\nend\n\ncmd:reihe(n)\n    for i in 1..n\n        await place:hütte\n        right:3\n    end\nend\n\nif genug-holz(3) then\n    reihe:3\n    say \"Hütte: {building-at(cursor.x - 3, cursor.y).state}\"\nelse\n    wait until genug-holz(3)\nend",
      "textAlign": "left",
      "updated": 1795049071525,
      "version": 1,
      "versionNonce": 1003952697,
      "verticalAlign": "top"
    }

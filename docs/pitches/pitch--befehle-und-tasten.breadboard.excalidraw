    {
      "id": "note",
      "type": "text",
      "x": 0,
      "y": 950,
      "width": 530,
      "height": 180,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 18,
      "frameId": null,
      "groupIds": [],
      "index": "b0R",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Jede Wirkung ist ein Befehl mit Id-Pfad:\nup, up:20, build:hütte, repair:all,\nrepair:under:5, tool:holzhacken, text:word-next …\nTasten binden an Befehle samt Argument,\noder an Ketten mit «;».\n«20» dann ↑ ergibt up:20;\n«2» dann eine Taste für up:20 ergibt up:40;\n«4» dann ein Makro: viermal.",
      "roughness": 1,
      "roundness": null,
      "seed": 175593967,
      "strokeColor": "#868e96",

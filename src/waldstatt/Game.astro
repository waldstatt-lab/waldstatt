---
/**
 * The Waldstatt: a building game that fills the home page (ADR 0002). The
 * map is a PixiJS canvas; the toolbox, menus and texts on the map are HTML. The site's
 * texts lie here in inert templates, rendered at build time from the shared
 * game Markdown and the studio texts below; the game hides them in the
 * forest, and visitors find them by felling it. Without JavaScript or WebGL only the still forest and a
 * note show.
 */
import { render } from "astro:content";
import { getGames } from "../lib/games";
import { goods } from "./game/config";
import Forest from "./Forest.astro";
import Icon from "./Icon.astro";
import type { IconName } from "./icons";
import meta from "./meta";

/** The supplies, the Waldleute and motivation, as the resource bar shows them. */
const resources: { key: string; name: string; icon: IconName }[] = [
  ...goods.map((g) => ({ key: g.key, name: g.name, icon: g.key as IconName })),
  { key: "people", name: "Waldleute / Betten", icon: "workers" },
  { key: "mood", name: "Stimmung", icon: "mood" },
  { key: "deaths", name: "Verstorbene", icon: "tomb" },
];

const games = await getGames();
const rendered = await Promise.all(
  games.map(async (game) => ({ game, Content: (await render(game)).Content })),
);

const gameData = games.map((game) => ({
  id: game.id,
  title: game.data.title,
  tagline: game.data.tagline,
  playUrl: game.data.playUrl,
  sourceUrl: game.data.sourceUrl,
}));
// Inside <script>, "<" could end the element early; JSON allows it escaped.
const gameJson = JSON.stringify(gameData).replace(/</g, "\\u003c");
---

<div class="wg" data-wg>
  <div class="wg-fallback" data-fallback>
    <Forest />
    <div class="wg-fallback-card">
      <h1>{meta.name}</h1>
      <p
        data-fallback-note
        data-no-webgl="Die Waldstatt braucht WebGL. Dieser Browser bietet es nicht an."
      >
        Die Waldstatt braucht JavaScript und WebGL. Ohne sie bleibt der Wald zu.
      </p>
    </div>
  </div>

  <div
    class="wg-map"
    data-map
    data-ready-show
    tabindex="0"
    role="application"
    aria-label={`${meta.name}: der Wald`}
    aria-describedby="wg-map-help"
    hidden
  ></div>
  <!-- The keys from the keymap, written by ui.ts. -->
  <p id="wg-map-help" data-map-help hidden></p>
  <p class="wg-panel wg-count" data-count aria-hidden="true" hidden></p>

  <div class="wg-panel wg-resources" data-resources data-ready-show hidden>
    <p class="wg-name">{meta.name}</p>
    <ul class="wg-supplies" aria-label="Vorrat">
      {resources.map((r) => (
        <li title={r.name} data-resource={r.key} hidden>
          <Icon name={r.icon} />
          <span data-value={r.key}>0</span>
          <span class="sr-only"> {r.name}</span>
        </li>
      ))}
    </ul>
  </div>

  <div
    class="wg-panel wg-finder"
    data-finder
    role="dialog"
    aria-label="Suchen"
    hidden
  >
    <div class="wg-finder-row">
      <span class="wg-finder-prefix" data-finder-prefix aria-hidden="true">
        /
      </span>
      <input
        type="text"
        data-finder-input
        role="combobox"
        aria-expanded="true"
        aria-controls="wg-finder-list"
        aria-autocomplete="list"
        autocomplete="off"
        spellcheck="false"
      />
    </div>
    <ul id="wg-finder-list" role="listbox" data-finder-list></ul>
  </div>

  <div class="wg-back" data-back hidden>
    <button type="button" class="wg-button wg-primary">
      Zurück zur Karte
    </button>
  </div>

  <div
    class="wg-panel wg-menu wg-build"
    id="wg-build-menu"
    data-build-menu
    hidden
  >
    <h2>Bauen</h2>
    <div class="wg-build-list" data-build-list></div>
  </div>

  <div class="wg-panel wg-menu wg-main" id="wg-main-menu" data-main-menu hidden>
    <h2>Menü</h2>
    <ul class="wg-supplies wg-menu-supplies" aria-label="Vorrat">
      {resources.map((r) => (
        <li title={r.name} data-resource={r.key} hidden>
          <Icon name={r.icon} />
          <span data-value={r.key}>0</span>
          <span class="wg-supply-name">{r.name}</span>
        </li>
      ))}
    </ul>
    <ul>
      <li>
        <button type="button" class="wg-button" data-act="home">
          Zur ersten Lichtung
        </button>
      </li>
      <li class="wg-actions">
        <button type="button" class="wg-button" data-act="zoom-in">
          Näher
        </button>
        <button type="button" class="wg-button" data-act="zoom-out">
          Weiter weg
        </button>
      </li>
      <li>
        <button type="button" class="wg-button" data-act="saves">
          Wälder speichern und laden …
        </button>
      </li>
      <li>
        <button type="button" class="wg-button" data-act="reset">
          Neu beginnen …
        </button>
      </li>
      <li>
        <button type="button" class="wg-button" data-act="keys">
          Tasten …
        </button>
      </li>
      <li class="wg-keys" data-keys-help></li>
      <li class="wg-credit">
        Gewässer und Landesgrenze: Bundesamt für Landestopografie swisstopo
        (swissTLM3D, swissBOUNDARIES3D); Flussordnungszahlen: Bundesamt für
        Umwelt BAFU
      </li>
    </ul>
  </div>

  <nav
    class="wg-toolbox"
    aria-label="Werkzeugkasten"
    data-toolbox
    data-ready-show
    hidden
  >
    <div class="wg-tools">
      <button
        type="button"
        class="wg-tool"
        data-tool="axe"
        aria-pressed="false"
        hidden
      >
        <Icon name="axe" /> Axt
      </button>
      <button
        type="button"
        class="wg-tool"
        data-tool="saw"
        aria-pressed="false"
        hidden
      >
        <Icon name="saw" /> Säge
      </button>
      <button
        type="button"
        class="wg-tool"
        data-tool="pave"
        aria-pressed="false"
        hidden
      >
        <Icon name="pave" /> Pflastern
      </button>
      <button
        type="button"
        class="wg-tool"
        data-tool="demolish"
        aria-pressed="false"
      >
        <Icon name="demolish" /> Abreissen
      </button>
      <button
        type="button"
        class="wg-tool"
        data-open="build"
        aria-expanded="false"
        aria-controls="wg-build-menu"
      >
        <Icon name="build" /> Bauen
        <span class="wg-fresh" data-fresh hidden>
          <span class="sr-only"> (neu)</span>
        </span>
      </button>
      <button
        type="button"
        class="wg-tool"
        data-open="menu"
        aria-expanded="false"
        aria-controls="wg-main-menu"
      >
        Menü
      </button>
    </div>
  </nav>

  <dialog
    class="wg-dialog wg-confirm"
    data-confirm
    aria-labelledby="wg-confirm-title"
  >
    <form method="dialog">
      <h2 id="wg-confirm-title" data-confirm-title></h2>
      <p data-confirm-text></p>
      <div class="wg-actions">
        <button
          class="wg-button wg-primary"
          value="yes"
          data-confirm-yes
        ></button>
        <button class="wg-button" value="no">
          Abbrechen
        </button>
      </div>
    </form>
  </dialog>

  <dialog
    class="wg-dialog wg-saves"
    data-saves
    aria-labelledby="wg-saves-title"
  >
    <h2 id="wg-saves-title">Wälder</h2>
    <form class="wg-saves-new" data-saves-form>
      <label for="wg-saves-name">Diesen Wald speichern als</label>
      <div class="wg-saves-row">
        <input
          id="wg-saves-name"
          type="text"
          maxlength="60"
          required
          autocomplete="off"
          spellcheck="false"
          data-saves-name
        />
        <button type="submit" class="wg-button wg-primary">
          Speichern
        </button>
      </div>
    </form>
    <h3>Gespeicherte Wälder</h3>
    <p class="wg-saves-empty" data-saves-empty hidden>
      Noch kein Wald gespeichert.
    </p>
    <ul class="wg-saves-list" data-saves-list></ul>
    <div class="wg-actions">
      <button type="button" class="wg-button" data-saves-export>
        Diesen Wald herunterladen
      </button>
      <button type="button" class="wg-button" data-saves-import>
        Wald aus Datei …
      </button>
      <input
        type="file"
        accept=".json,application/json"
        hidden
        data-saves-file
      />
    </div>
    <p class="wg-saves-status" data-saves-status></p>
    <form method="dialog" class="wg-actions">
      <button class="wg-button">Schliessen</button>
    </form>
  </dialog>

  <dialog
    class="wg-dialog wg-keymap"
    data-keys
    aria-labelledby="wg-keymap-title"
  >
    <h2 id="wg-keymap-title">Tasten</h2>
    <p>
      Eine Aktion kann mehrere Tasten haben, eine Taste gehört zu einer Aktion.
      Im Text gelten eigene Tasten: Sie gehen dort vor, und Umschalt zählt, «G»
      ist nicht «g». Escape, Tab und die Ziffern bleiben fest: Ziffern vor einer
      Bewegung, wie «10» und dann «→», bewegen so viele Felder oder Zeilen weit.
    </p>
    <div class="wg-keymap-groups" data-keys-list></div>
    <p class="wg-keymap-status" data-keys-status></p>
    <div class="wg-actions">
      <button type="button" class="wg-button" data-keys-reset>
        Standard …
      </button>
    </div>
    <form method="dialog" class="wg-actions">
      <button class="wg-button">Schliessen</button>
    </form>
  </dialog>

  <p class="sr-only" aria-live="polite" data-live></p>

  <template data-text="ortstafel">
    <h2>{meta.name}</h2>
    <p>
      «Waldstatt» ist die historische Bezeichnung für Einsiedeln. Der heutige
      Bezirk Einsiedeln wurde früher als «Waldstatt Einsiedeln» bezeichnet,
      seine Bewohner als «Waldleute».
    </p>
    <p>
      Wir sind ein kleines Hobby-Spielestudio. Hier rodest du den Wald wie die
      Waldleute, baust Häuser – und findest dabei unsere Spiele.
    </p>
  </template>

  <template data-text="chronik">
    <h2>Wer wir sind</h2>
    <p>
      {meta.name} ist ein kleines Hobby-Spielestudio. Wir programmieren Spiele,
      die direkt im Browser laufen, ohne Installation.
    </p>
    <h2>Wie alles begann</h2>
    <p>
      Am Nationalen Zukunftstag, dem 12. November 2026, haben wir aus Skizzen
      auf Papier unsere ersten spielbaren Prototypen gebaut: Moto Devil und Car
      Drive. Seither entwickeln wir beide weiter.
    </p>
    <h2>Wie wir arbeiten</h2>
    <p>
      Jede Idee beginnt als Skizze. Daraus schreiben wir einen kurzen Plan: Was
      fehlt, wie könnte die Lösung aussehen, und was lassen wir bewusst weg?
      Dann bauen wir einen Prototyp und probieren ihn aus.
    </p>
    <h2>Womit wir bauen</h2>
    <p>
      Unsere Spiele sind in Rust mit der Spiel-Engine Bevy geschrieben und
      laufen als WebAssembly im Browser. Der Quellcode ist auf GitHub
      öffentlich.
    </p>
  </template>

  {rendered.map(({ game, Content }) => (
    <template data-text={`game:${game.id}`}>
      <Content />
    </template>
  ))}

  <script type="application/json" id="wg-games" is:inline set:html={gameJson} />
</div>

<script>
  import "./game/main";
</script>
